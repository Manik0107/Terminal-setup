# Ghostty — shared across Linux (incl. WSL/WSLg) and macOS
#
# GENERATED FILE WARNING: install.sh concatenates this with config.linux or
# config.macos into ~/.config/ghostty/config and substitutes the absolute zsh
# and env paths. Edit the files in this repo, not the generated one, then
# re-run install.sh.
#
# Live-reload the running window with: ctrl+shift+,
# Inspect what Ghostty actually parsed with: ghostty +show-config

# ---- Font ------------------------------------------------------------------
# Same face Windows Terminal uses, so tmux/herdr and oh-my-posh glyphs render
# identically on every platform. install.sh installs it.
font-family = 0xProto Nerd Font Mono
font-size = 18

# ---- Colors ----------------------------------------------------------------
# Mirrors the #0a0a0a + cyan scheme in tmux/.tmux.conf and herdr/config.toml
background = #0a0a0a
foreground = #e6e6e6
cursor-color = #22d3ee
cursor-style = block
cursor-style-blink = false
selection-background = #163b44
selection-foreground = #e6e6e6

# ---- Window ----------------------------------------------------------------
window-padding-x = 6
window-padding-y = 4
confirm-close-surface = true
# The resize dimensions popup is noise when herdr already shows geometry.
resize-overlay = never

# ---- Keys ------------------------------------------------------------------
# Plain ctrl+v pastes, on every platform, so the binding is the same muscle
# memory everywhere. Ghostty's ctrl+shift+v still works; the cost is that TUIs
# never see ctrl+v (nvim visual-block, readline quoted-insert) inside Ghostty.
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+m=toggle_maximize

# ---- Behaviour -------------------------------------------------------------
mouse-hide-while-typing = true
copy-on-select = clipboard
# OSC 52 WRITE is the real win under WSL: there is no wl-copy, xclip or
# win32yank there, so tmux yank reaching the Windows clipboard depends on it
# entirely. That is `set -g set-clipboard on` in .tmux.conf, and it needs
# clipboard-write only.
#
# Read is the opposite direction and a separate permission. `allow` would let
# any program in the terminal silently read the system clipboard over OSC 52 -
# including a compromised host you have SSH'd into - and a clipboard routinely
# holds password-manager output. `ask` is Ghostty's own default.
#
# This does NOT affect ctrl+v: paste_from_clipboard is a terminal keybind
# action, not a program request, so it never consults clipboard-read. Only a
# program asking to read the clipboard prompts. The one case where that can
# happen here is pasting into Neovim with `p` (LazyVim sets
# clipboard=unnamedplus) when the text was copied from a Windows app rather
# than yanked in nvim - nvim then falls back to a real OSC 52 read. Use ctrl+v
# for that, or allow the prompt.
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
# herdr owns real scrollback; keep Ghostty's buffer modest.
scrollback-limit = 10000000

# zsh integration is auto-injected: prompt marking, cwd inheritance on split,
# sudo password prompt detection.
shell-integration = zsh
shell-integration-features = cursor,sudo,title
